# Copy to .env (not versioned) and fill in local values.

# Root folder for all project data (raw sources, corpus builds, runs, transcripts).
# Must be an absolute path, preferably on the large data disk.
ARTIGO_DATA_ROOT=

# Hugging Face cache (datasets and models).
HF_HOME=

# PyTorch hub cache.
TORCH_HOME=

# uv package cache.
UV_CACHE_DIR=

# Browsers downloaded by Playwright (recorder).
PLAYWRIGHT_BROWSERS_PATH=
